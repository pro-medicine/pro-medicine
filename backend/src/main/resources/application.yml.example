spring:
  config:
    import: optional:file:./.env[.properties]
  application:
    name: pro-medicine

  datasource:
    url: ${MYSQL_URL}
    username: ${MYSQL_USERNAME}
    password: ${MYSQL_PASSWORD}
    driver-class-name: com.mysql.cj.jdbc.Driver

  jpa:
    hibernate:
      ddl-auto: update
    show-sql: true
    open-in-view: false # LLM 대기 중 DB 커넥션을 잡지 않도록 끔 (config/recommendation-defaults.properties와 같은 값)
    defer-datasource-initialization: true
    properties:
      hibernate:
        format_sql: true
        dialect: org.hibernate.dialect.MySQLDialect

# 식약처 건강기능식품 API 키 (backend/.env에 MFDS_API_KEY=... , 없어도 서버는 켜지고 import만 실패)
mfds:
  api-key: ${MFDS_API_KEY:}
